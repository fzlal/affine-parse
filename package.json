{
  "name": "affine-parse",
  "version": "1.0.0",
  "description": "Convert .affine backup files to structured Markdown",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "export": "bun run src/index.ts export",
    "import": "bun run src/index.ts import",
    "build": "bun build src/index.ts --compile --outfile affine-parse",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "bun x tsc --noEmit"
  },
  "bin": {
    "affine-parse": "./src/index.ts"
  },
  "keywords": ["affine", "markdown", "backup", "converter"],
  "repository": {
    "type": "git",
    "url": "https://github.com/fzlal/affine-parse"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-extension-gfm": "^3.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yjs": "^13.6.31"
  }
}
